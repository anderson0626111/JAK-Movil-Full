# Cambiar esta clave por una cadena larga y aleatoria antes de publicar el sistema.
ADMIN_TOKEN_SECRET=coloca-aqui-una-clave-segura

# Opcionales: permiten enviar los codigos temporales por correo mediante Resend.
# En desarrollo, si se omiten, el codigo se muestra en la pantalla y en la terminal.
RESEND_API_KEY=
PASSWORD_RESET_FROM=JAK MOVIL <acceso@tu-dominio.com>
NODE_ENV=development
